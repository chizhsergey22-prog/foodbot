# ==============================
# Telegram
# ==============================
BOT_TOKEN=7xxxxxxxxx:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ID первого суперадмина (узнать через @getmyid_bot)
SUPER_ADMIN_IDS=123456789,987654321

# URL мини-приложения (ваш домен с https)
MINI_APP_URL=https://your-domain.com

# Для фронтенда (должен совпадать с реальным адресом)
VITE_API_URL=/api

# ==============================
# PostgreSQL
# ==============================
POSTGRES_DB=food_bot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=supersecretpassword
DATABASE_URL=postgresql+asyncpg://postgres:supersecretpassword@postgres:5432/food_bot

# ==============================
# Redis
# ==============================
REDIS_URL=redis://redis:6379/0

# ==============================
# Google Sheets (опционально)
# Создайте сервисный аккаунт в Google Cloud, скачайте credentials.json
# Дайте доступ к таблицам email сервисного аккаунта
# ==============================
GOOGLE_CREDENTIALS_FILE=/app/credentials.json
# ID папки Google Drive куда сохранять отчёты (из URL папки)
GOOGLE_DRIVE_FOLDER_ID=

# ==============================
# Настройки приложения
# ==============================
# Дедлайн приёма заказов (по умолчанию, можно изменить командой /cutoff)
DEFAULT_CUTOFF_TIME=17:00
TIMEZONE=Europe/Kyiv
